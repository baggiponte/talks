{
  "name": "talks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "cf deploy --dry-run",
    "deploy": "cf deploy",
    "test:unit": "node --test \"src/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.18",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
